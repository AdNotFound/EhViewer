<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:orientation="vertical"
        android:padding="4dp"
        android:paddingStart="7dp">

        <LinearLayout
            android:id="@+id/image_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Space
                android:id="@+id/image_leading_space"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/image_slot"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_reader_sidebar_placeholder">

                <com.hippo.ehviewer.widget.ReaderSidebarThumb
                    android:id="@+id/image"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:foreground="?selectableItemBackground"
                    app:alwaysCutAndScale="true"
                    app:aspect="1.0"
                    app:maxAspect="0.8"
                    app:minAspect="0.5"
                    app:retryType="longClick" />

                <ProgressBar
                    android:id="@+id/image_loading"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:visibility="gone" />
            </FrameLayout>

            <Space
                android:id="@+id/image_gap"
                android:layout_width="4dp"
                android:layout_height="1dp" />

            <FrameLayout
                android:id="@+id/image_secondary_slot"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_reader_sidebar_placeholder">

                <com.hippo.ehviewer.widget.ReaderSidebarThumb
                    android:id="@+id/image_secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:foreground="?selectableItemBackground"
                    app:alwaysCutAndScale="true"
                    app:aspect="1.0"
                    app:maxAspect="0.8"
                    app:minAspect="0.5"
                    app:retryType="longClick" />

                <ProgressBar
                    android:id="@+id/image_secondary_loading"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:visibility="gone" />
            </FrameLayout>

            <Space
                android:id="@+id/image_trailing_space"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:visibility="gone" />

        </LinearLayout>

        <TextView
            android:id="@+id/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="4dp"
            android:textAppearance="@style/TextAppearance.AppCompat.Caption"
            android:textColor="?attr/textColorThemeAccent" />
    </LinearLayout>

    <View
        android:id="@+id/indicator"
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:layout_gravity="start|center_vertical"
        android:background="@drawable/bg_reader_sidebar_indicator"
        android:visibility="gone" />
</FrameLayout>
